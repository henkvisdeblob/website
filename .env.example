# Copy to .env.local and fill in. Never commit real values.
# Without Supabase and Brevo the waitlist works in development only (in-memory, emails printed to the console).

# Public URL of the site, used in email links (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown in the privacy statement and footer
NEXT_PUBLIC_OWNER_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase (EU region). Use the project's secret key (or legacy service_role key). Server only!
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Brevo transactional email (EU). EMAIL_FROM must be a sender verified in Brevo.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Potje

# Supermarket deals (PrijsProfeet). Works without a key; a free key (https://www.prijsprofeet.nl/api#gratis-key)
# gives your own, higher rate limit. Check the key and the live source with `npm run check:deals`.
PRIJSPROFEET_API_KEY=
# DEALS_SOURCE=sample uses fictional sample deals (tests/offline development).
DEALS_SOURCE=

# Plausible analytics (cookieless). Paste the script URL from your Plausible site settings.
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Only for end-to-end tests of a production build without external services. Never set in production.
# WAITLIST_ALLOW_MEMORY_STORE=1
# WAITLIST_RATE_LIMIT=1000
# PLAN_RATE_LIMIT=1000
